{
  "name": "@upstars-global/unity-ui",
  "version": "1.29.0",
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:themes": "node ./scripts/replace-component-colors.ts --write && node ./scripts/replace-component-presets.ts --write",
    "generate:themes:presets": "node ./scripts/replace-component-presets.ts --write",
    "figma:connect": "figma connect",
    "figma:connect:parse": "figma connect parse --exit-on-unreadable-files",
    "figma:connect:publish": "figma connect publish",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "deps:check": "depcruise src --config .dependency-cruiser.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release",
    "chromatic": "npx chromatic",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@figma/code-connect": "^2.1.0",
    "@octokit/auth-app": "^8.3.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/tsconfig": "0.8.1",
    "autoprefixer": "^10.6.2",
    "chromatic": "^18.4.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-vue": "^10.12.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "dayjs": "^1.11.23",
    "vue3-mask": "upstars-global/vue3-mask#v3.0.8",
    "vue3-outside-events": "upstars-global/vue3-outside-events#v2.0.5"
  }
}
